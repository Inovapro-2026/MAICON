generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================= ENUMS =============================

enum LeadStatus {
  PENDING
  PROCESSING
  SENT
  RESPONDED
  AGENT_ACTIVE
  INTERESTED
  NOT_INTERESTED
  OPT_OUT
  ERROR
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum ChannelMode {
  WHATSAPP
  EMAIL
  BOTH
}

enum MessageChannel {
  WHATSAPP
  EMAIL
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

/**
 * Estágio comercial da conversa — decidido dinamicamente pela IA (Motor
 * Comercial). Substitui o OnboardingStage fixo: a IA avalia o que já sabe e
 * avança a conversa pelo funil (descoberta → avaliação → negociação → fechado).
 */
enum ConversationStage {
  NEW
  QUALIFYING
  DISCOVERY
  EVALUATION
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum LeadSource {
  CSV
  MANUAL
  TEST
  WEB
  WHATSAPP_GROUP
}

enum WhatsAppGroupExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum OptOutChannel {
  WHATSAPP
  EMAIL
}

enum ProspectionStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ImportStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum UserRole {
  ADMIN
}

enum ChannelType {
  WHATSAPP
  EMAIL
}

// ==================== MULTI-TENANT / PLATAFORMA (SAVYRON) ====================

enum BusinessStatus {
  PENDING_PAYMENT
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BusinessRole {
  OWNER
  BUSINESS_ADMIN
  MANAGER
  AGENT
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
  PLATFORM_STAFF
}

// ============================= AUTH =============================

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  password_hash      String
  name               String
  role               UserRole      @default(ADMIN)
  platform_role      PlatformRole  @default(NONE)
  active             Boolean       @default(true)
  must_change_password Boolean     @default(true)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  memberships BusinessMember[]
}

model Setting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// MULTI-TENANT: Business = a empresa/tenant.
// Toda entidade de domínio pertence a um Business (via business_id).
// ---------------------------------------------------------------------------
model Business {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  status       BusinessStatus  @default(TRIAL)
  /**
   * Motivo da suspensão automática (quando Business.status = SUSPENDED).
   * Valores: "subscription_expired" (vencimento sem pagamento) ou null.
   * Permite distinguir suspensão por billing (login -> /payment) de suspensão
   * manual pelo admin (login bloqueado).
   */
  suspension_reason String?
  legal_name   String?
  trade_name   String?
  cnpj         String?
  segment      String?
  description  String?
  email        String?
  phone        String?
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  members    BusinessMember[]
  settings   BusinessSettings?
  leads      Lead[]
  lead_imports LeadImport[]
  campaigns  Campaign[]
  campaign_leads CampaignLead[]
  prospection_runs ProspectionRun[]
  messages   Message[]
  conversations Conversation[]
  ai_generations AIGeneration[]
  opt_outs   OptOut[]
  delivery_events DeliveryEvent[]
  subscriptions Subscription[]
  payments   Payment[]
  usage      Usage[]
  audit_logs AuditLog[]
  ai_agents  AIAgent[]
  ai_settings AISettings[]
  ai_knowledge AIKnowledge[]
  email_logs EmailLog[]
  sales_conversation_insights SalesConversationInsight[]
  commercial_strategies CommercialStrategy[]
  notifications Notification[]
  whatsapp_group_extractions WhatsAppGroupExtraction[]
  whatsapp_group_sources WhatsAppGroupSource[]
  whatsapp_group_leads WhatsAppGroupLead[]

  @@index([status])
}


model BusinessSettings {
  business_id           String @id
  whatsapp_daily_limit  Int    @default(30)
  email_daily_limit     Int    @default(100)
  interval_seconds      Int    @default(7200)
  test_mode_max_leads   Int    @default(5)
  address               String?
  website               String?
  instagram             String?
  opening_hours         String?
  timezone              String @default("America/Sao_Paulo")
  logo_url              String?
  additional_info       String?
  /**
   * CONTEXTO DA EMPRESA para a IA — dados factuais estruturados usados pelo
   * agente (identidade, público, problemas, diferenciais, posicionamento,
   * canais, instruções). A Base de conhecimento segue sendo a fonte detalhada
   * de produtos/preços/políticas; estes campos são a visão geral da empresa.
   */
  target_audience       String?
  problems_solved       String?
  differentials         String?
  positioning           String?
  service_area          String?
  business_objectives   String?
  additional_instructions String?
  updated_at            DateTime @updatedAt
  created_at            DateTime @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
}

model BusinessMember {
  id          String        @id @default(cuid())
  business_id String
  user_id     String
  role        BusinessRole  @default(AGENT)
  created_at  DateTime      @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([business_id, user_id])
  @@index([user_id])
  @@index([business_id])
}

// ============================= LEADS =============================

model Lead {
  id            String        @id @default(cuid())
  business_id   String
  name          String?
  phone         String?
  email         String?
  business_name String?
  city          String?
  state         String?
  source        LeadSource    @default(CSV)
  status        LeadStatus    @default(PENDING)
  external_id   String?
  imported_via  LeadImport?   @relation(fields: [imported_via_id], references: [id])
  imported_via_id String?

  fingerprint_phone  String?
  fingerprint_email  String?
  fingerprint_extid  String?

  // Prospecção automática (SAVYRON Prospector)
  fingerprint_domain   String?
  fingerprint_namecity String?
  website              String?
  instagram            String?
  facebook             String?
  whatsapp             String?
  address              String?
  country              String?
  segment              String?
  source_url           String?
  source_type          String?
  collected_at         DateTime?
  lead_score           Int?
  prospection_run_id   String?

  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  business         Business         @relation(fields: [business_id], references: [id])
  campaign_leads   CampaignLead[]
  messages         Message[]
  conversations    Conversation[]
  opt_outs         OptOut[]
  ai_generations   AIGeneration[]
  prospection_run  ProspectionRun?  @relation(fields: [prospection_run_id], references: [id], onDelete: SetNull)
  whatsapp_group_leads WhatsAppGroupLead[]

  @@index([status])
  @@index([email])
  @@index([created_at])
  @@index([business_id])
  @@index([business_id, created_at])
  @@index([business_id, status])
  @@unique([business_id, fingerprint_phone])
  @@unique([business_id, fingerprint_email])
  @@unique([business_id, fingerprint_extid])
}

model LeadImport {
  id         String       @id @default(cuid())
  business_id String
  filename   String
  source     String       @default("CSV")
  status     ImportStatus @default(QUEUED)
  summary    Json?
  total      Int          @default(0)
  new_leads  Int          @default(0)
  duplicates Int          @default(0)
  invalid    Int          @default(0)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  business Business @relation(fields: [business_id], references: [id])
  leads Lead[]

  @@index([business_id])
  @@index([business_id, created_at])
}

// ============================= CAMPANHAS =============================

model Campaign {
  id                   String         @id @default(cuid())
  business_id          String
  name                 String
  status               CampaignStatus @default(PAUSED)
  daily_whatsapp_limit Int            @default(30)
  daily_email_limit    Int            @default(100)
  interval_seconds     Int            @default(7200)
  is_test              Boolean        @default(false)
  start_hour           Int?
  channel_mode         ChannelMode    @default(WHATSAPP)
  /** Mensagem de e-mail configurada pelo usuário (canais EMAIL e BOTH). */
  email_subject        String?
  email_body           String?
  /** Primeira mensagem de abordagem do WhatsApp (opcional). Vazio = padrão. */
  wa_first_message     String?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  business      Business       @relation(fields: [business_id], references: [id])
  campaign_leads CampaignLead[]
  messages      Message[]
  prospection_runs ProspectionRun[]
  whatsapp_group_extractions WhatsAppGroupExtraction[]

  @@index([business_id])
  @@index([business_id, status])
  @@index([business_id, created_at])
}

model CampaignLead {
  id              String   @id @default(cuid())
  business_id     String
  campaign_id     String
  lead_id         String
  status          LeadStatus @default(PENDING)
  attempts        Int      @default(0)
  last_attempt_at DateTime?
  next_attempt_at DateTime?
  channel         MessageChannel?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  business Business @relation(fields: [business_id], references: [id])

  @@unique([business_id, campaign_id, lead_id])
  @@index([campaign_id, status])
  @@index([next_attempt_at])
  @@index([business_id])
}

// ============================= PROSPECÇÃO =============================

model ProspectionRun {
  id               String            @id @default(cuid())
  business_id      String
  campaign_id      String?
  segment          String?
  country          String?
  state            String?
  city             String?
  target_quantity  Int               @default(100)
  status           ProspectionStatus @default(PENDING)
  /**
   * Fontes de prospecção ativas nesta run: ["google_maps"], ["instagram"] ou
   * ambos. Vazio = fonte web padrão (Overpass/Firecrawl). Auditável por run.
   */
  sources          Json?
  found_count      Int               @default(0)
  saved_count      Int               @default(0)
  duplicate_count  Int               @default(0)
  discarded_count  Int               @default(0)
  error_count      Int               @default(0)
  phone_count      Int               @default(0)
  email_count      Int               @default(0)
  avg_score        Float?
  summary          Json?
  started_at       DateTime?
  completed_at     DateTime?
  cancelled_at     DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  business Business  @relation(fields: [business_id], references: [id])
  campaign Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  leads    Lead[]

  @@index([business_id])
  @@index([business_id, created_at])
}

// ===================== EXTRAÇÃO DE CONTATOS (GRUPOS WHATSAPP) =====================
// Fluxo multi-tenant: a extração é enfileirada no BullMQ e executada no worker
// (mesma sessão Baileys da empresa — nunca abre conexão paralela). A extração
// JAMAIS envia mensagens: os contatos vão para revisão/leads antes de qualquer
// campanha. `whatsapp_groups_consent` registra a aceitação do checkbox de
// responsabilidade legal (obrigatório antes da primeira extração).

model WhatsAppGroupExtraction {
  id                 String                       @id @default(cuid())
  business_id        String
  status             WhatsAppGroupExtractionStatus @default(PENDING)
  /** JIDs dos grupos selecionados (Baileys). */
  group_ids          String[]
  remove_duplicates  Boolean                      @default(true)
  ignore_own_contact Boolean                      @default(true)
  exclude_admins     Boolean                      @default(false)
  auto_enrich        Boolean                      @default(false)
  /** "leads" | "enrich" | "campaign" — destino dos contatos extraídos. */
  destination        String                       @default("leads")
  /** Contatos encontrados (soma de participantes dos grupos, após exclusões). */
  found_count        Int                          @default(0)
  /** Contatos únicos (por telefone) após deduplicação. */
  unique_count       Int                          @default(0)
  /** Participantes já existentes nos leads da empresa (duplicados). */
  duplicate_count    Int                          @default(0)
  /** Únicos com telefone válido. */
  phone_count        Int                          @default(0)
  /** Únicos com site (candidatos a enriquecimento via Scrapy). */
  enriched_count     Int                          @default(0)
  /** Únicos com telefone e qualificados para campanha. */
  qualified_count    Int                          @default(0)
  campaign_id        String?
  error_message      String?
  started_at         DateTime?
  completed_at       DateTime?
  created_at         DateTime                     @default(now())
  updated_at         DateTime                     @updatedAt

  business Business                    @relation(fields: [business_id], references: [id])
  campaign Campaign?                   @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  sources  WhatsAppGroupSource[]

  @@index([business_id])
  @@index([business_id, created_at])
}

model WhatsAppGroupSource {
  id                String   @id @default(cuid())
  business_id       String
  extraction_id     String?
  /** Nome do grupo exibido no painel. */
  group_name        String
  /** Identificador do grupo no WhatsApp/Baileys (JID @g.us). */
  group_identifier  String
  participant_count Int      @default(0)
  extracted_at      DateTime @default(now())

  extraction WhatsAppGroupExtraction? @relation(fields: [extraction_id], references: [id], onDelete: SetNull)
  business   Business                 @relation(fields: [business_id], references: [id])
  leads      WhatsAppGroupLead[]

  @@unique([extraction_id, group_identifier])
  @@index([business_id])
  @@index([extraction_id])
  @@index([group_identifier])
}

model WhatsAppGroupLead {
  id          String   @id @default(cuid())
  business_id String
  source_id   String
  lead_id     String
  is_admin    Boolean  @default(false)
  created_at  DateTime @default(now())

  source   WhatsAppGroupSource @relation(fields: [source_id], references: [id], onDelete: Cascade)
  lead     Lead                 @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  business Business             @relation(fields: [business_id], references: [id])

  @@unique([source_id, lead_id])
  @@index([lead_id])
  @@index([business_id])
}

// ============================= MENSAGENS =============================

model Message {
  id          String            @id @default(cuid())
  business_id String
  lead_id     String
  campaign_id String?
  channel     MessageChannel
  direction   MessageDirection
  content     String
  status      MessageStatus     @default(QUEUED)
  provider    String?
  external_id String?
  created_at  DateTime          @default(now())

  business        Business          @relation(fields: [business_id], references: [id])
  lead            Lead              @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  campaign        Campaign?         @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  delivery_events DeliveryEvent[]

  @@index([lead_id, created_at])
  @@index([campaign_id, created_at])
  @@index([channel, created_at])
  @@index([business_id, created_at])
}

// ============================= CONVERSAS =============================

model Conversation {
  id              String             @id @default(cuid())
  business_id     String
  lead_id         String
  status          ConversationStatus @default(OPEN)
  ai_provider     String?
  human_handled   Boolean            @default(false)
  /** Estágio comercial atual, decidido dinamicamente pela IA. */
  stage           ConversationStage  @default(NEW)
  /** Versão do Motor Comercial usada na última resposta (rollout/rollback). */
  commercial_engine_version String?
  /** Técnica comercial usada na última resposta (ex.: tactical_empathy). */
  last_technique_used String?
  last_message_at DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  business       Business        @relation(fields: [business_id], references: [id])
  lead           Lead            @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  ai_generations AIGeneration[]

  @@unique([business_id, lead_id])
  @@index([business_id, last_message_at])
  @@index([business_id, stage])
}

// ============================= IA =============================

model AIGeneration {
  id               String  @id @default(cuid())
  business_id      String
  lead_id          String
  conversation_id  String?
  provider         String
  model            String
  prompt_version   String
  /** Técnica comercial usada nesta geração (Motor Comercial). */
  technique_used   String?
  /** Versão do Motor Comercial (v1, ...) para análise de conversão/resolução. */
  commercial_engine_version String?
  /** Próximo passo comercial decidido (Strategy/Decision Engine) — alimenta o
   *  aprendizado por tenant (qual pergunta foi feita em cada turno). */
  next_action String?
  prompt           String?
  completion       String?
  input_tokens     Int     @default(0)
  output_tokens    Int     @default(0)
  latency_ms       Int     @default(0)
  error            String?
  created_at       DateTime @default(now())

  business     Business     @relation(fields: [business_id], references: [id])
  lead         Lead         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([business_id, created_at])
}

// ============================= OPT-OUT =============================

model OptOut {
  id         String         @id @default(cuid())
  business_id String
  lead_id    String
  channel    OptOutChannel
  reason     String?
  created_at DateTime       @default(now())

  business Business @relation(fields: [business_id], references: [id])
  lead Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
  @@index([channel])
  @@index([business_id])
}

// ============================= WEBHOOKS =============================

model DeliveryEvent {
  id         String   @id @default(cuid())
  business_id String?
  message_id String?
  event      String
  payload    Json?
  created_at DateTime @default(now())

  business Business? @relation(fields: [business_id], references: [id])
  message Message? @relation(fields: [message_id], references: [id], onDelete: SetNull)

  @@index([business_id, created_at])
}

// ============================= E-MAILS ENVIADOS (RESEND) =============================

enum EmailLogStatus {
  SENT
  FAILED
  BOUNCED
}

model EmailLog {
  id                 String         @id @default(cuid())
  business_id        String
  to                 String
  subject            String
  status             EmailLogStatus @default(SENT)
  provider           String         @default("resend")
  provider_message_id String?
  related_campaign_id String?
  error              String?
  sent_at            DateTime       @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, sent_at])
  @@index([business_id, status])
}

// ============================= PLANOS / BILLING (SAVYRON) =============================

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String?
  price           Decimal         @default(0) @db.Decimal(10, 2)
  billing_interval BillingInterval @default(MONTHLY)
  trial_days      Int             @default(0)
  active          Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  sort_order      Int             @default(0)
  stripe_product_id String?
  stripe_price_id   String?
  // Cakto (novo gateway — PIX recorrente).
  cakto_product_id String?
  cakto_offer_id   String?

  features     PlanFeature[]
  subscriptions Subscription[]

  @@index([active])
}

model PlanFeature {
  id      String @id @default(cuid())
  plan_id String
  feature String
  enabled Boolean @default(true)
  limit   Int?

  plan Plan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, feature])
  @@index([plan_id])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CARD
}

enum AITone {
  PROFESSIONAL
  FRIENDLY
  CASUAL
  RELAXED
  PREMIUM
  CONSULTATIVE
  TECHNICAL
}

enum AIKnowledgeCategory {
  PRODUCTS
  SERVICES
  PLANS
  PRICES
  PROMOTIONS
  HOURS
  DAYS
  PAYMENT
  ADDRESS
  FAQ
  POLICIES
  BENEFITS
  COMMERCIAL_RULES
  LINKS
  INTERNAL_RULES
}

model Subscription {
  id                  String             @id @default(cuid())
  business_id         String
  plan_id             String?
  status              SubscriptionStatus  @default(TRIALING)
  // Stripe (gateway atual).
  stripe_customer_id   String?
  stripe_subscription_id String?
  stripe_price_id      String?
  // Cakto (novo gateway — PIX recorrente).
  cakto_subscription_id String?
  cakto_product_id     String?
  cakto_offer_id       String?
  cakto_checkout_url   String?
  // AbacatePay (gateway atual — PIX manual, sem recorrência automática).
  abacatepay_customer_id String?
  abacatepay_checkout_id String?
  current_period_start DateTime?
  current_period_end  DateTime?
  trial_ends_at       DateTime?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  plan_name           String?
  plan_price          Decimal?           @db.Decimal(10, 2)
  cancelled_at        DateTime?

  business Business       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  plan     Plan?          @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  payments Payment[]

  @@unique([business_id])
  @@index([business_id, status])
  @@index([plan_id])
  @@index([status])
  @@index([stripe_customer_id])
  @@index([stripe_subscription_id])
  @@index([cakto_subscription_id])
  @@index([abacatepay_checkout_id])
}

model Payment {
  id                 String        @id @default(cuid())
  subscription_id    String
  business_id        String
  // Stripe (gateway atual).
  stripe_payment_intent_id String?
  stripe_checkout_session_id String?
  stripe_charge_id   String?
  // Cakto (novo gateway — PIX recorrente).
  cakto_order_id     String?
  cakto_ref_id       String?
  cakto_event        String?
  // AbacatePay (gateway atual — PIX manual, sem recorrência automática).
  abacatepay_checkout_id String?
  abacatepay_event       String?
  method             PaymentMethod @default(PIX)
  status             PaymentStatus @default(PENDING)
  value              Decimal       @db.Decimal(10, 2)
  due_date           DateTime?
  paid_at            DateTime?
  pix_payload        String?
  pix_qr_base64      String?
  external_reference String?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, created_at])
  @@index([subscription_id])
  @@index([status])
  @@unique([stripe_payment_intent_id])
  @@unique([stripe_checkout_session_id])
  @@unique([cakto_order_id])
  @@unique([abacatepay_checkout_id])
}

model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  code_hash  String
  expires_at DateTime
  attempts   Int       @default(0)
  verified_at DateTime?
  created_at DateTime  @default(now())

  @@index([email, created_at])
}

model Usage {
  id          String   @id @default(cuid())
  business_id String
  metric      String
  quantity    Int      @default(0)
  period      String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, metric, period])
  @@index([business_id, period])
  @@index([metric, period])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String?
  business_id String?
  action      String
  entity      String?
  entity_id   String?
  metadata    Json?
  created_at  DateTime @default(now())

  business Business? @relation(fields: [business_id], references: [id], onDelete: SetNull)

  @@index([business_id, created_at])
  @@index([actor, created_at])
  @@index([action, created_at])
  @@index([entity, entity_id])
}

// ============================= IA (SAVYRON) =============================

model AIAgent {
  id          String   @id @default(cuid())
  business_id String
  name        String
  role        String?
  description String?
  /** Objetivo do agente, gerado automaticamente pela configuração estruturada. */
  objective   String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business Business    @relation(fields: [business_id], references: [id], onDelete: Cascade)
  settings AISettings[]

  @@index([business_id])
  @@index([business_id, active])
}

model AISettings {
  id             String   @id @default(cuid())
  business_id    String
  agent_id       String?
  tone           AITone   @default(FRIENDLY)
  behaviors      Json     @default("{}")
  message_config Json     @default("{}")
  custom_prompt  String?
  /**
   * MODO DO AGENTE ("Objetivo do agente"): sales | support | sales_support.
   * O mesmo agente com estratégia comportamental adaptável — nunca cria
   * agentes separados.
   */
  agent_mode     String   @default("sales_support")
  /** Última aplicação automática da configuração estruturada ("Aplicar na IA"). */
  last_applied_at DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  agent    AIAgent? @relation(fields: [agent_id], references: [id], onDelete: SetNull)

  @@unique([business_id])
  @@index([business_id])
}

model AIKnowledge {
  id          String              @id @default(cuid())
  business_id String
  title       String
  content     String
  category    AIKnowledgeCategory @default(FAQ)
  /**
   * Palavras-chave (separadas por vírgula) que melhoram a recuperação do
   * conhecimento ("preço, valor, quanto custa"). Opcional.
   */
  keywords    String?
  active      Boolean             @default(true)
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id])
  @@index([business_id, active])
}

model ConversationMemory {
  id           String   @id @default(cuid())
  business_id  String
  /** "conversation:{id}" (WhatsApp) ou "session:{id}" (playground). */
  key          String
  summary      String   @default("")
  current_goal String   @default("start_rapport")
  next_action  String   @default("BUILD_RAPPORT")
  last_question String  @default("")
  sales_stage  String   @default("NEW")
  known_json   Json?
  /**
   * Perguntas já feitas pelo agente nesta conversa — evita repetir perguntas
   * ("Oi" horas depois não reinicia nem re-pergunta). Array de strings.
   */
  asked_questions Json?
  /** Última mensagem recebida do cliente (contexto para continuidade). */
  last_customer_message String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([business_id, key])
  @@index([business_id])
}

// ============================= APRENDIZADO COMERCIAL (INTELIGÊNCIA DO TENANT) =============================

enum InsightOutcome {
  CONVERTED
  ABANDONED
  LOST
  ONGOING
}

enum StrategyStatus {
  LEARNING
  ACTIVE
  DISCARDED
}

/**
 * Insight extraído de uma conversa encerrada/análise — o "evento" bruto do
 * Conversation Learning Engine. PERTENCE A UM ÚNICO TENANT (business_id).
 * A agregação destes insights vira `CommercialStrategy` (padrões do tenant).
 * NUNCA consultar/inserir sem `business_id`.
 */
model SalesConversationInsight {
  id                   String         @id @default(cuid())
  business_id          String
  conversation_id      String         @unique
  lead_id              String
  segment              String?
  acquisition_channel  String?
  /** Estágio comercial no encerramento/última análise (ConversationStage). */
  stage_at_close       String?
  /** Resultado comercial: convertido, abandonou, perdeu ou em andamento. */
  outcome              InsightOutcome @default(ONGOING)
  message_count        Int            @default(0)
  agent_question_count Int            @default(0)
  customer_message_count Int          @default(0)
  /** Nº de mensagens até pedir preço / demonstrar interesse de compra. */
  messages_to_price    Int?
  messages_to_conversion Int?
  last_agent_question  String?
  last_customer_message String?
  /** Dores recorrentes (array de strings). */
  pains                Json?
  /** Objeções frequentes (array de strings). */
  objections           Json?
  /** Necessidades reveladas (array de strings). */
  needs                Json?
  /** Perguntas feitas pelo agente: { text, response_length, continuity }. */
  questions            Json?
  /** Técnicas comerciais usadas ao longo da conversa (array). */
  techniques           Json?
  strategy_used        String?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, outcome])
  @@index([business_id, created_at])
  @@index([business_id, segment])
  @@index([business_id, lead_id])
}

/**
 * Estratégia comercial APRENDIDA de um tenant — a inteligência comercial da
 * empresa. Sempre isolada por `business_id`: Tenant A nunca lê/encontra
 * estratégias do Tenant B. Versionada; só é usada automaticamente pelo Decision
 * Engine quando `status = ACTIVE` e `sample_count`/`confidence` atingem os
 * limites configurados.
 */
model CommercialStrategy {
  id            String         @id @default(cuid())
  business_id   String
  /** Identificador semântico ("ask_before_present", "explore_pain"...). */
  strategy_id   String
  version       Int            @default(1)
  name          String
  description   String?
  /** Perfil de aplicação (opcional): segmento/canal a que a estratégia se aplica. */
  segment       String?
  acquisition_channel String?
  /** Fato que a estratégia endereça (name|segment|acquisition_channel|need|pain|objective|budget|objection|tools). */
  missing_fact  String?
  /** Próxima ação recomendada (NextAction: ASK_*, UNDERSTAND_PAIN, EXPLAIN_RELEVANT_SOLUTION...). */
  recommended_next_action String
  sample_count  Int            @default(0)
  confidence    Float          @default(0)
  success_rate  Float          @default(0)
  continuity_rate Float        @default(0)
  response_rate Float          @default(0)
  interest_rate Float          @default(0)
  conversion_rate Float        @default(0)
  last_success_at DateTime?
  status        StrategyStatus @default(LEARNING)
  /** Metadados de aprendizado (contadores internos). */
  meta          Json?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, strategy_id, version])
  @@index([business_id, status])
  @@index([business_id, segment])
  @@index([business_id, recommended_next_action])
}

// ============================= NOTIFICAÇÕES (MULTI-TENANT) =============================

model Notification {
  id              String    @id @default(cuid())
  business_id     String
  type            String    @default("WHATSAPP_RESPONSE")
  title           String
  description     String
  preview         String?
  lead_id         String?
  conversation_id String?
  message_id      String?   @unique
  read            Boolean   @default(false)
  read_at         DateTime?
  created_at      DateTime  @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, read])
  @@index([business_id, created_at])
}

// ============================= CHAVES DE API (PLATAFORMA) =============================

model ApiKey {
  id            String    @id @default(cuid())
  provider      String    // 'elevenlabs' | 'groq' | 'openai'
  label         String?   // rótulo opcional (ex.: "Chave principal")
  key_encrypted String    // valor criptografado (AES-256-GCM)
  key_hash      String    // sha256 do valor (busca/dedup sem descriptografar)
  key_suffix    String    // últimos 4 caracteres (exibição na UI)
  status        String    @default("ACTIVE") // 'ACTIVE' | 'EXHAUSTED'
  priority      Int       @default(0)        // menor = preferencial
  last_error    String?
  used_at       DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([provider, status, priority])
  @@index([key_hash])
}

