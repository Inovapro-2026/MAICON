# =============================================================================
# CRM INOVA - variáveis de ambiente
# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o arquivo .env com credenciais reais.
# =============================================================================

# --- Banco de dados (Neon PostgreSQL) ---
DATABASE_URL="postgresql://neondb_owner:CHANGE_ME@ep-empty-smoke-ax8h2hsu-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Redis (filas BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- IA (Groq principal, OpenRouter fallback) ---
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# Modelos por padrão (opcionais)
GROQ_MODEL="openai/gpt-oss-120b"
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct"
AI_TIMEOUT_MS="30000"

# --- E-mail (Resend) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="contato@inovapro.shop"
EMAIL_FROM_NAME="SAVYRON"

# --- Pagamentos (Stripe) — gateway atual ---
# Chaves de TESTE (sk_test_/pk_test_) primeiro; trocar por live quando validado.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Signing secret do webhook endpoint "CRM" (whsec_) — Stripe > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=""
# Payment Method Configuration ID (habilita PIX + cartão no Checkout).
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID="pmc_xxx"

# --- Pagamentos (Cakto) — novo gateway (PIX recorrente) ---
# OAuth2: Client ID / Client Secret do app Cakto.
CAKTO_CLIENT_ID=""
CAKTO_CLIENT_SECRET=""
# Secret do webhook criado no Cakto (validação do corpo { secret, event, data }).
CAKTO_WEBHOOK_SECRET=""
# URL base da API (default https://api.cakto.com.br)
CAKTO_API_BASE_URL=""

# --- WhatsApp / Baileys ---
WHATSAPP_SESSION_PATH="/root/CRM/session"

# --- Aplicação ---
NEXT_PUBLIC_APP_URL="https://crm.inovapro.cloud"
API_BASE_URL="http://localhost:4005"
DASHBOARD_URL="http://localhost:3005"
SESSION_SECRET="change-me-to-a-long-random-string"
# Token usado pela sessão do navegador para chamar a API
API_TOKEN="change-me-to-another-long-random-string"

# --- Tempo real (WebSocket/Socket.IO) ---
# Em produção deixe VAZIO: o browser conecta no mesmo origin (/socket.io) e o
# nginx faz proxy para a API (4005). Em desenvolvimento local use:
NEXT_PUBLIC_SOCKET_URL=""

# --- Login padrão do administrador (primeiro acesso obriga troca de senha) ---
ADMIN_EMAIL="ceo.inovapro@maicon"
ADMIN_PASSWORD="Inovapro$2026"

# --- Limites padrão de campanha ---
DEFAULT_WHATSAPP_DAILY_LIMIT="30"
DEFAULT_EMAIL_DAILY_LIMIT="100"
DEFAULT_INTERVAL_SECONDS="7200"
# Limite máximo por mensagem de texto gerada por IA
AI_MAX_MESSAGE_LENGTH="600"

# --- Portas ---
DASHBOARD_PORT="3005"
API_PORT="4005"
WORKER_PORT="5005"

# --- Modo de teste: importa apenas N leads ---
TEST_MODE_MAX_LEADS="5"

# --- Segurança da API ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"

# --- Prospector (SAVYRON Prospector) ---
# Chave da API Firecrawl (nunca colocar no frontend / nunca commitar)
FIRECRAWL_API_KEY=""
FIRECRAWL_API_BASE_URL="https://api.firecrawl.dev"
# Sem FIRECRAWL_API_KEY configurada com PROSPECTOR_PROVIDER=firecrawl, a
# prospecção falha com erro claro
# ("Prospecção indisponível: mecanismo de descoberta não configurado.").
# Com PROSPECTOR_PROVIDER=auto (padrão) ou overpass, usa a Overpass API (OSM).
# Não existe fallback para dados fabricados.

# Provedor de descoberta: firecrawl | overpass | auto (padrão)
PROSPECTOR_PROVIDER="auto"

# --- Overpass API (fonte gratuita, OpenStreetMap) ---
# Instância pública por padrão; permita apontar para self-hosted no futuro.
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OVERPASS_TIMEOUT_MS="60000"
OVERPASS_RETRY_ATTEMPTS="2"
# Geocoding de cidade/estado/país -> bounding box (respeita policy de User-Agent)
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

# --- Serviço de enriquecimento (Scrapy, processo PM2 prospector-scrapy) ---
SCRAPY_SERVICE_URL="http://localhost:6810"
SCRAPY_CONCURRENCY="2"
SCRAPY_REQUEST_DELAY_MS="1000"

# Concorrência do worker de prospecção (jobs simultâneos por processo)
PROSPECTOR_CONCURRENCY="3"

# Delay aleatório entre operações de descoberta/crawling (ms)
PROSPECTOR_MIN_DELAY_MS="1500"
PROSPECTOR_MAX_DELAY_MS="4000"

# Limites de crawling/busca
PROSPECTOR_MAX_PAGES_PER_DOMAIN="5"
PROSPECTOR_MAX_RESULTS_PER_SEARCH="20"

# Timeout e retry
PROSPECTOR_JOB_TIMEOUT_MS="900000"
# Timeout POR REQUISIÇÃO à fonte de descoberta (Firecrawl/Overpass), em ms.
PROSPECTOR_REQUEST_TIMEOUT_MS="60000"
PROSPECTOR_RETRY_ATTEMPTS="3"

# Proteção contra abuso (por tenant)
PROSPECTOR_MAX_LEADS_PER_RUN="500"
PROSPECTOR_MAX_ACTIVE_PER_TENANT="1"
PROSPECTOR_MAX_PENDING_PER_TENANT="3"

# Batching
PROSPECTOR_BATCH_SIZE="10"

# Rate limit global (compartilhado entre workers) e por tenant
PROSPECTOR_RATE_LIMIT_PER_MINUTE="30"
PROSPECTOR_RATE_LIMIT_WINDOW_MS="60000"
PROSPECTOR_RATE_LIMIT_PER_TENANT_PER_HOUR="100"
